{
    "manifest_version": 3,
    "name": "Capture All",
    "version": "1.0.21",
    "author": "Ish Kapoor",
    "description": "Records user interactions, network requests, and screen elements.",
    "permissions": [
        "activeTab",
        "storage",
        "tabs",
        "scripting",
        "debugger",
        "downloads",
        "tabCapture",
        "offscreen"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_security_policy": {
        "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data:"
    },
    "storage": {
        "managed_schema": "managed_schema.json"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Capture All",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}